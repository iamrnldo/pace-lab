# backend/.env

# OPSI A (paling gampang untuk Neon/Supabase/Railway): satu connection string.
# Contoh: postgres://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb
# Kalau DATABASE_URL diisi, variabel DB_* di bawah tidak dipakai.
DATABASE_URL=

# OPSI B: variabel terpisah
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=running_calculator
DB_USER=postgres
DB_PASSWORD=your_password
DB_SSL=false

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Admin Account (auto-created on startup)
ADMIN_EMAIL=admin@pacelab.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=PaceLab Admin
